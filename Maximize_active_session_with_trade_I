#include <string>
#include <algorithm>

class Solution {
public:
    int maxActiveSectionsAfterTrade(std::string s) {
        int totalOnes = 0;
        int maxZeroGain = 0;
        int prevZeroLen = 0;
        bool hasPrevZero = false;

        int n = s.length();
        int i = 0;

        while (i < n) {
            int j = i;

            while (j < n && s[j] == s[i]) {
                j++;
            }

            int curLen = j - i;

            if (s[i] == '1') {
                totalOnes += curLen;
            } else {

                if (hasPrevZero) {
                    maxZeroGain = std::max(maxZeroGain, prevZeroLen + curLen);
                }
                

                prevZeroLen = curLen;
                hasPrevZero = true;
            }

            i = j;
        }

        return totalOnes + maxZeroGain;
    }
};
        
