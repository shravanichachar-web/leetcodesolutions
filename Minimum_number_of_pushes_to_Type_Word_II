#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    int minimumPushes(std::string word) {
        std::vector<int> freq(26, 0);
        for (char c : word) {
            freq[c - 'a']++;
        }

        std::sort(freq.rbegin(), freq.rend());

        int total_pushes = 0;

        for (int i = 0; i < 26; ++i) {
            if (freq[i] == 0) {
                break;
            } 

            int push_cost = (i / 8) + 1;
            total_pushes += freq[i] * push_cost;
        }

        return total_pushes;
        
    }
};
