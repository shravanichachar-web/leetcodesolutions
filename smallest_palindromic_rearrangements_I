#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    string smallestPalindrome(string s) {
        vector<int> freq(26, 0);

        for (char c : s) {
            freq[c - 'a']++;
        }

        string left_half = "";
        char mid_char = '\0';

        for (int i = 0; i < 26; i++) {

            if (freq[i] % 2 != 0) {
                mid_char = 'a' + i;
            }

            if (freq[i] > 0) {
                left_half.append(freq[i] / 2, 'a' + i);
            }
        }

        string right_half = left_half;
        reverse(right_half.begin(), right_half.end());

        if (mid_char != '\0') {
            return left_half + mid_char + right_half;
        }

        return left_half + right_half;
        
    }
};
