#include <vector>

class Solution {
public:
    int countCompleteComponents(int n, vector<vector<int>>& edges) {
        vector<vector<int>> adj(n);

        for (const auto& edge : edges) {

            adj[edge[0]].push_back(edge[1]);

            adj[edge[1]].push_back(edge[0]);
        }

        vector<bool> visited(n, false);
        int completeComponents = 0;

        for (int i = 0; i < n; ++i) {
            if (!visited[i]) {
                int nodeCount = 0;
                int degreeSum = 0;

                dfs(i, adj, visited, nodeCount, degreeSum);

                if (degreeSum == nodeCount * (nodeCount -1)) {

                    completeComponents++;
                }
            }
        }

        return completeComponents;
        
    }

    void dfs(int u, const vector<vector<int>>& adj, vector<bool>& visited, int& nodeCount, int& degreeSum) {

        visited[u] = true;
        nodeCount++;
        degreeSum += adj[u].size();

        for (int v : adj[u]) {
            if (!visited[v]) {
                dfs(v, adj, visited, nodeCount, degreeSum);
            }
        }
    }

};
